{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "android": {
        "buildType": "apk"
      },
      "channel": "production",
      "autoIncrement": true
    },
    "play": {
      "extends": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_VARIANT": "play"
      }
    },
    "appstore": {
      "extends": "production",
      "env": {
        "APP_VARIANT": "appstore"
      }
    },
    "ios-sim": {
      "extends": "appstore",
      "ios": {
        "simulator": true
      }
    }
  },
  "submit": {
    "play": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft",
        "serviceAccountKeyPath": "./play-sa.json"
      }
    },
    "appstore": {
      "ios": {
        "ascAppId": "6819052816",
        "ascApiKeyPath": "./asc-key.p8",
        "ascApiKeyId": "96P4C5L673",
        "ascApiKeyIssuerId": "808fc64a-bb32-43d8-89c3-19b5b7daf208"
      }
    }
  }
}
